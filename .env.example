NEXT_PUBLIC_API_URL=http://localhost:7071/api
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Server only. Use both service-account values, or omit both to use Application Default Credentials.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Server only: PostgreSQL connection for bills and audits.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/proxic
# Server only. Sandbox credentials and a random 32-byte encryption key encoded as 64 hex characters.
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_TOKEN_ENCRYPTION_KEY=
# Server only: independent random 32-byte key encoded as 64 hex characters.
FORWARDING_ALIAS_ENCRYPTION_KEY=
# Server only: approval validity in hours (1-720; default 24).
PAYMENT_APPROVAL_TTL_HOURS=24
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
