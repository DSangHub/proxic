generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
  tasks     Task[]
}

model Task {
  id        String     @id @default(uuid())
  userId    String
  title     String
  status    String     @default("pending")
  proxy     String
  riskLevel Int        @default(1)
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id])
  approvals Approval[]
}

model Bill {
  id               String            @id @default(uuid())
  ownerUid         String
  merchant         String
  amountMinor      Int
  currency         String
  dueDate          DateTime          @db.Date
  accountLastFour  String?
  source           BillSource
  status           BillStatus        @default(AWAITING_APPROVAL)
  riskLevel        Int
  approvalRequired Boolean
  fingerprint      String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  reviewedAt       DateTime?
  decidedAt        DateTime?
  submissions      BillSubmission[]
  approvals        Approval[]
  paymentDecisions PaymentDecision[]
  auditEvents      AuditEvent[]

  @@unique([ownerUid, fingerprint])
  @@unique([id, ownerUid])
  @@index([ownerUid, createdAt])
}

model BillSubmission {
  id               String     @id @default(uuid())
  billId           String?
  ownerUid         String
  source           BillSource
  receivedAt       DateTime   @default(now())
  processedAt      DateTime?  @default(now())
  sender           String?
  subject          String?
  processingStatus String     @default("processed")
  scanStatus       String     @default("not_applicable")
  attachments      Json?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  bill             Bill?      @relation(fields: [billId, ownerUid], references: [id, ownerUid])

  @@index([ownerUid, billId])
}

model ForwardingAlias {
  id             String    @id @default(uuid())
  ownerUid       String
  aliasHash      String    @unique
  encryptedToken String?
  purpose        String    @default("bill")
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  rotatedAt      DateTime?
  revokedAt      DateTime?

  @@index([ownerUid, active])
}

model PlaidConnection {
  ownerUid       String               @id
  status         PlaidConnectionState @default(LINKING)
  encryptedToken String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  bankConnection BankConnection?
}

model BankConnection {
  id              String               @id @default(uuid())
  ownerUid        String               @unique
  provider        String               @default("PLAID")
  plaidItemId     String?
  institutionId   String?
  institutionName String?
  status          PlaidConnectionState @default(LINKING)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  plaidConnection PlaidConnection      @relation(fields: [ownerUid], references: [ownerUid], onDelete: Cascade)
  accounts        BankAccount[]
}

model BankAccount {
  id               String         @id @default(uuid())
  bankConnectionId String
  accountId        String
  displayName      String
  mask             String?
  type             String
  subtype          String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  bankConnection   BankConnection @relation(fields: [bankConnectionId], references: [id], onDelete: Cascade)

  @@unique([bankConnectionId, accountId])
}

enum PlaidConnectionState {
  LINKING
  EXCHANGING
  ACTIVE
  DISCONNECTING
}

model Approval {
  id                String           @id @default(uuid())
  taskId            String?
  task              Task?            @relation(fields: [taskId], references: [id])
  billId            String?
  ownerUid          String?
  bill              Bill?            @relation(fields: [billId, ownerUid], references: [id, ownerUid])
  status            String           @default("pending")
  proposedAction    Json?
  createdAt         DateTime         @default(now())
  decidedAt         DateTime?
  paymentDecisionId String?
  approvalTokenHash String?          @unique
  billSnapshotHash  String?
  amountCents       Int?
  currency          String?
  merchantName      String?
  accountLast4      String?
  bankConnectionId  String?
  expiresAt         DateTime?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  cancelledAt       DateTime?
  updatedAt         DateTime         @default(now())
  paymentDecision   PaymentDecision? @relation(fields: [paymentDecisionId], references: [id], onDelete: Restrict)

  @@index([ownerUid, billId, status])
  @@index([ownerUid, status, expiresAt])
}

model PaymentPolicy {
  id                              String            @id @default(uuid())
  userId                          String
  name                            String
  merchantName                    String
  merchantFingerprint             String
  accountLast4                    String?
  mode                            String
  maximumAmountCents              Int?
  minimumAmountCents              Int?
  currency                        String
  allowedBankConnectionId         String?
  typicalAmountCents              Int?
  variancePercent                 Float?
  requireApprovalAboveCents       Int?
  requireApprovalForFirstPayment  Boolean           @default(true)
  requireApprovalForAmountChange  Boolean           @default(true)
  requireApprovalForDueDateChange Boolean           @default(true)
  active                          Boolean           @default(true)
  createdAt                       DateTime          @default(now())
  updatedAt                       DateTime          @updatedAt
  decisions                       PaymentDecision[]

  @@unique([userId, merchantFingerprint, accountLast4])
  @@index([userId, active])
}

model PaymentDecision {
  id               String         @id @default(uuid())
  userId           String
  billId           String
  policyId         String?
  decision         String
  riskLevel        Int
  reasons          Json
  amountCents      Int?
  currency         String?
  merchantName     String?
  accountLast4     String?
  bankConnectionId String?
  policySnapshot   Json
  billSnapshot     Json
  billSnapshotHash String
  expiresAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  bill             Bill           @relation(fields: [billId, userId], references: [id, ownerUid], onDelete: Restrict)
  policy           PaymentPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)
  approvals        Approval[]

  @@index([userId, billId, createdAt])
  @@index([userId, policyId, createdAt])
}

model AuditEvent {
  id        String   @id @default(uuid())
  actor     String
  action    String
  resource  String
  metadata  Json?
  createdAt DateTime @default(now())
  ownerUid  String?
  billId    String?
  bill      Bill?    @relation(fields: [billId, ownerUid], references: [id, ownerUid])

  @@index([ownerUid, billId, createdAt])
}

enum BillSource {
  MANUAL
  FORWARDED_EMAIL
}

enum BillStatus {
  AWAITING_APPROVAL
  APPROVED
  REJECTED
}
