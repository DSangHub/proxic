enum PaymentPolicyMode { NOTIFY_ONLY ALWAYS_ASK AUTO_APPROVE_ELIGIBLE BLOCKED }
enum PaymentDecisionType { NOTIFY_ONLY APPROVAL_REQUIRED ELIGIBLE_FOR_FUTURE_AUTOPAY BLOCKED MANUAL_REVIEW }
enum ApprovalStatus { PENDING APPROVED REJECTED EXPIRED CANCELLED CONSUMED }

model PaymentPolicy {
  id String @id @default(uuid())
  userId String
  name String
  merchantName String?
  merchantFingerprint String?
  accountLast4 String?
  mode PaymentPolicyMode
  maximumAmountCents Int?
  minimumAmountCents Int?
  currency String @default("USD")
  allowedBankConnectionId String?
  typicalAmountCents Int?
  variancePercent Int?
  requireApprovalAboveCents Int?
  requireApprovalForFirstPayment Boolean @default(true)
  requireApprovalForAmountChange Boolean @default(true)
  requireApprovalForDueDateChange Boolean @default(true)
  version Int @default(1)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  decisions PaymentDecision[]
  @@index([userId, active])
}

model PaymentDecision {
  id String @id @default(uuid())
  userId String
  billId String
  policyId String?
  decision PaymentDecisionType
  riskLevel Int
  reasons Json
  amountCents Int
  currency String
  merchantName String
  accountLast4 String?
  bankConnectionId String?
  policySnapshot Json?
  billSnapshotHash String
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  policy PaymentPolicy? @relation(fields:[policyId], references:[id])
  approval Approval?
  @@index([userId, billId])
}

model Approval {
  id String @id @default(uuid())
  userId String
  billId String
  paymentDecisionId String @unique
  status ApprovalStatus @default(PENDING)
  approvalTokenHash String @unique
  billSnapshotHash String
  amountCents Int
  currency String
  merchantName String
  accountLast4 String?
  bankConnectionId String?
  idempotencyKey String @unique
  expiresAt DateTime
  approvedAt DateTime?
  rejectedAt DateTime?
  cancelledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  decision PaymentDecision @relation(fields:[paymentDecisionId], references:[id])
  @@index([userId, status])
}
